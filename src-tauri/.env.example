# Copy this file to src-tauri/.env if you need to override any defaults.
# Everything here is optional - the app talks to a local llama-server on
# http://localhost:8080 out of the box, no key required.

# LOCAL_LLM_BASE_URL=http://localhost:8080
# LOCAL_LLM_MODEL=local-model
# Only needed if you started llama-server with --api-key:
# LOCAL_LLM_API_KEY=

# ComfyUI integration. Defaults assume the setup script's layout:
# ~/comfy/ComfyUI. Override if your install lives somewhere else.
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_OUTPUT_DIR=$HOME/comfy/ComfyUI/output
# COMFYUI_LORAS_DIR=$HOME/comfy/ComfyUI/models/loras
# KOHYA_TRAIN_SCRIPT=/absolute/path/to/train_anima_lora.sh
